{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.1.0",
  "default_locale": "en",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "src/background.js" },
  "options_ui": { "page": "src/options/options.html", "open_in_tab": true },
  "action": { "default_title": "__MSG_extName__" },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.co.jp/dp/*",
        "https://www.amazon.co.jp/*/dp/*",
        "https://www.amazon.co.jp/gp/product/*",
        "https://amazon.co.jp/dp/*",
        "https://amazon.co.jp/*/dp/*",
        "https://amazon.co.jp/gp/product/*",
        "https://item.rakuten.co.jp/*",
        "https://www.yodobashi.com/product/*"
      ],
      "js": [
        "src/sites/common.js",
        "src/sites/amazon.js",
        "src/sites/rakuten.js",
        "src/sites/yodobashi.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
